# KiCad files are text. Normalise line endings so a Windows machine and a Linux
# machine do not produce a diff on every line of an untouched file.
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_pro   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_mod   text eol=lf
fp-lib-table  text eol=lf
sym-lib-table text eol=lf
*.md          text eol=lf
*.ino         text eol=lf
*.py          text eol=lf
*.csv         text eol=lf

# Windows-only helper, keep CRLF so PowerShell is happy.
*.ps1         text eol=crlf

# Binary — never try to merge or diff these as text.
*.step  binary
*.STEP  binary
*.stp   binary
*.stl   binary
*.SLDPRT binary
*.wrl   binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.xlsx  binary

# Show the schematic and layout as text in diffs, but do not attempt a merge:
# a three-way merge of a .kicad_pcb produces a file KiCad cannot open.
*.kicad_sch  -merge
*.kicad_pcb  -merge
